# Required: Anthropic API key for the AI coach (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for coaching reports
# CLAUDE_MODEL=claude-sonnet-5

# Optional: OpenDota API key for higher rate limits (not required for MVP use)
# OPENDOTA_API_KEY=

# Optional but recommended: STRATZ API key (https://stratz.com/api). Powers
# the Heroes page's Build Inspector (role win rates, item builds, talents)
# and its "best lane partners" section, plus per-match role classification
# on the Match Story tab. Without it those sections are omitted/estimated
# rather than shown as fact - OpenDota counter-pick data still works.
# STRATZ_API_KEY=

# Required for Steam login: any long random string, used to sign the session
# cookie. Generate one locally, e.g. `openssl rand -hex 32` - it's not a
# third-party credential, just a local secret.
SESSION_SECRET=
