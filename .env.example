# AI coach runs locally via Ollama (https://ollama.com) - no API key needed.
# Install Ollama, run `ollama pull qwen3:8b`, then `ollama serve`.

# Optional: override the Ollama server URL
# OLLAMA_URL=http://localhost:11434

# Optional: override the Ollama model used for coaching reports
# OLLAMA_MODEL=qwen3:8b

# Optional: the largest context window a request may use (tokens). Each
# request picks the smallest window its prompt fits in, up to this cap.
# OLLAMA_NUM_CTX=8192

# Optional: how many model layers to keep on the GPU (the rest run on the
# CPU). Leave unset: the app lets Ollama decide and only falls back to fewer
# layers when the model doesn't fit in video memory.
# OLLAMA_NUM_GPU=24

# Optional: OpenDota API key for higher rate limits (not required for MVP use)
# OPENDOTA_API_KEY=

# Optional but recommended: STRATZ API key (https://stratz.com/api). Powers
# the Heroes page's Build Inspector (role win rates, item builds, talents)
# and its "best lane partners" section, plus per-match role classification
# on the Match Story tab. Without it those sections are omitted/estimated
# rather than shown as fact - OpenDota counter-pick data still works.
# STRATZ_API_KEY=

# Battle pass: payment isn't connected yet. Set to 1 on a test setup to let
# the "buy" button activate the pass for free. Never set it in production.
# BATTLE_PASS_DEV_UNLOCK=1

# Optional: where the battle pass progress file lives (default .data/battle-pass.json)
# BATTLE_PASS_STORE=

# Required for Steam login: any long random string, used to sign the session
# cookie. Generate one locally, e.g. `openssl rand -hex 32` - it's not a
# third-party credential, just a local secret.
SESSION_SECRET=
