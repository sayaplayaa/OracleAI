# Required: Anthropic API key for the AI coach (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for coaching reports
# CLAUDE_MODEL=claude-sonnet-5

# Optional: OpenDota API key for higher rate limits (not required for MVP use)
# OPENDOTA_API_KEY=

# Optional: STRATZ API key (https://stratz.com/api), used only for the Draft
# Explorer's "best lane partners" section (real teammate lane-synergy data,
# which OpenDota's public API doesn't expose). Without it, Draft Explorer
# still shows OpenDota counter-pick data.
# STRATZ_API_KEY=
